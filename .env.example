# wonsang_bot 환경설정 예시 — 복사해서 .env 로 사용 (.env 는 커밋 금지)

# --- 감지 ---
POLL_INTERVAL_SEC=2.0
UPBIT_ENABLED=true
BITHUMB_ENABLED=true
# 라이브에서 엔드포인트/스키마 재검증 후 필요시 override
# UPBIT_ANNOUNCEMENTS_URL=
# BITHUMB_ANNOUNCEMENTS_URL=
# 해외/데이터센터 IP 차단 대비 프록시(선택)
# HTTP_PROXY_URL=http://user:pass@host:port
HTTP_TIMEOUT_SEC=8.0
SEED_ONLY_FIRST_RUN=true

# --- 알림(텔레그램) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=true

# --- LLM (선택, 나중에 끄거나 교체 가능) ---
LLM_ENABLED=false
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# --- 컨트랙트 매핑(선택) ---
COINGECKO_ENABLED=false
COINGECKO_API_KEY=

# --- 저장/로깅 ---
DB_PATH=data/wonsang.sqlite
LOG_LEVEL=INFO
